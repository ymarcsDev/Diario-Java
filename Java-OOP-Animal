// Classe Abstrata (Abstração)
abstract class Animal {
    private String nome;
    private int idade;

    public Animal(String nome, int idade) {
        this.nome = nome;
        this.idade = idade;
    }

    // Método que cada animal implementará do seu jeito (Polimorfismo)
    public abstract void emitirSom();

    public void dormir() {
        System.out.println(nome + " está dormindo... ZzzZ");
    }

    // Getters (Encapsulamento)
    public String getNome() { return nome; }
    public int getIdade() { return idade; }
}

// Subclasse Cachorro (Herança)
class Cachorro extends Animal {
    public Cachorro(String nome, int idade) {
        super(nome, idade);
    }

    @Override
    public void emitirSom() {
        System.out.println(getNome() + " diz: Au Au! 🐶");
    }
}

// Subclasse Gato (Herança)
class Gato extends Animal {
    public Gato(String nome, int idade) {
        super(nome, idade);
    }

    @Override
    public void emitirSom() {
        System.out.println(getNome() + " diz: Miau! 🐱");
    }
}

// Classe Principal para rodar o sistema
public class Main {
    public static void main(String[] args) {
        // Criando uma lista de animais (Polimorfismo na prática)
        Animal[] animais = {
            new Cachorro("Rex", 5),
            new Gato("Luna", 3),
            new Cachorro("Thor", 2)
        };

        System.out.println("--- Sons dos Animais ---");
        for (Animal animal : animais) {
            animal.emitirSom(); // Cada um responde de um jeito
        }

        System.out.println("\n--- Ações ---");
        animais[1].dormir();
    }
}
